# General
DEV=false

# HTTPS: set your public IP + email. Leave OOPSYS_PUBLIC_IP empty for plain HTTP.
OOPSYS_PUBLIC_IP=
OOPSYS_ACME_EMAIL=
# OOPSYS_ACME_STAGING=true

APPLICATION__HOST=0.0.0.0
APPLICATION__PORT=8000

# PostgreSQL
POSTGRESQL__HOST=postgres
POSTGRESQL__PORT=5432
POSTGRESQL__USERNAME=oopsys
POSTGRESQL__PASSWORD=change-me-postgres
POSTGRESQL__DATABASE=oopsys

# NATS (bot worker fan-out)
NATS__ENABLED=true
NATS__SERVERS=["nats://nats:4222"]
NATS__STREAM=OOPSYS_SERVER
NATS__SUBJECT_PREFIX=oopsys

# Security — change before production
SECURITY__SECRET_KEY=change-me-please-very-long-random
SECURITY__BOT_TOKEN_KEY=change-me-bot-key-very-long-random
# true with OOPSYS_PUBLIC_IP (HTTPS); false for plain HTTP
SECURITY__COOKIE_SECURE=true
SECURITY__SESSION_TTL_SECONDS=43200
SECURITY__REMEMBER_TTL_SECONDS=2592000
SECURITY__MAX_FAILED_ATTEMPTS=5
SECURITY__CAPTCHA_AFTER_ATTEMPTS=3

# Notification throttling
NOTIFICATIONS__QUIET_GAP_SECONDS=120
NOTIFICATIONS__RENOTIFY_WINDOW_SECONDS=600

# Agent liveness
LIVENESS__STALE_SECONDS=90
LIVENESS__SCAN_INTERVAL_SECONDS=30
LIVENESS__POLL_ENABLED=false
